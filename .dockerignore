# Keep the build context small and, more importantly, keep secrets out of the
# image. .env holds live production database credentials — Render supplies the
# real values as service environment variables, so it must never be copied in.
.env
.env.*
!.env.example

node_modules
.next
.git
.github
.vercel
.graphify
graphify-out

# Not needed to run the app.
docs
coverage
**/*.test.ts
**/*.test.tsx
.claude
README.md
